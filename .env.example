# FOG Docker Compose Environment Variables
# Copy this to .env and adjust values for your environment

# IP address that PXE clients will use to reach the FOG master
FOG_IP=172.20.0.10

# Storage node IP (if using a separate storage node)
FOG_STORAGE_IP=172.20.0.11

# Database credentials
FOG_DB_ROOT_PASS=fogroot
FOG_DB_NAME=fog
FOG_DB_USER=fogstorage
FOG_DB_PASS=fogstorage

# System user credentials (used for FTP/NFS access to images)
FOG_USER=fogproject
FOG_USER_PASS=fogproject

# Venue prefix for storage node names (e.g. london, manchester, bristol)
FOG_VENUE=default

# ─── Storage Node Settings ───────────────────────────────────────────────────
# Max concurrent imaging clients per node (default: 10)
FOG_MAX_CLIENTS=10

# Bandwidth limit in KB/s (0 = unlimited)
FOG_BANDWIDTH_LIMIT=0

# Image storage path inside the container
FOG_STORAGE_DIR=/images

# Snapin storage path inside the container
FOG_SNAPIN_DIR=/opt/fog/snapins

# Network interface used for imaging traffic
FOG_INTERFACE=eth0
